#!/usr/bin/env bash
# Universal Design Suite CLI Launcher for tailwindcss
if [ -x "/home/ubuntu/snap/antigravity-cli/common/nodejs/bin/tailwindcss" ]; then
    exec "/home/ubuntu/snap/antigravity-cli/common/nodejs/bin/tailwindcss" ""
elif [ -x "/home/ubuntu/snap/antigravity-cli/common/local/lib/node_modules/@tailwindcss/cli/dist/index.js" ]; then
    exec "/home/ubuntu/snap/antigravity-cli/common/local/lib/node_modules/@tailwindcss/cli/dist/index.js" ""
else
    exec npx -y @tailwindcss/cli ""
fi
